<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>X Archive – Fan Base</title>
  <style>
    :root {
      --bg: #0f1220;
      --card: #171a2e;
      --muted: #9aa0ff;
      --accent: #b18cff;
      --text: #e7e9ff;
      --line: #2a2f55;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: radial-gradient(1200px 400px at 50% -10%, #1b1f45, var(--bg));
      color: var(--text);
    }
    .container { max-width: 1200px; margin: 0 auto; padding: 32px 20px 64px; }
    header { text-align: center; margin-bottom: 24px; }
    header h1 { margin: 0; font-size: 40px; letter-spacing: 0.5px; color: var(--accent); }

    .tabs { display: flex; gap: 18px; justify-content: center; border-bottom: 1px solid var(--line); margin: 20px 0 28px; }
    .tab { padding: 10px 2px; color: #cfd3ff; text-decoration: none; border-bottom: 2px solid transparent; }
    .tab.active { color: #fff; border-color: var(--accent); }

    .section-title { text-align: center; color: var(--muted); margin: 18px 0 18px; }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
    .card {
      background: linear-gradient(180deg, #1a1e3a, var(--card));
      border: 1px solid var(--line);
      border-radius: 14px; padding: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,.25);
    }
    .card h3 { margin: 0 0 6px; font-size: 16px; }
    .meta { font-size: 13px; color: #aab0ff; margin-bottom: 10px; }
    .source a { color: var(--accent); text-decoration: none; font-size: 13px; }

    .embed {
      position: relative; border-radius: 10px; overflow: hidden; border: 1px solid var(--line);
      background: #000; height: 0; padding-bottom: 56.25%;
    }
    .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    footer { text-align: center; color: #9aa0ff; margin-top: 36px; font-size: 13px; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>Fan Base</h1>
      <nav class="tabs">
        <a class="tab" href="#">Base House</a>
        <a class="tab active" href="#">X Archives</a>
        <a class="tab" href="#">Fan Support Accounts</a>
      </nav>
    </header>

    <div class="section-title">X Archive</div>

    <section class="grid">
      <!-- CARD 1 -->
      <article class="card">
        <h3>LINGORM 2025 FAN MEETING IN VIETNAM</h3>
        <div class="meta">December 13, 2025</div>
        <div class="source">Source: <a href="https://x.com/" target="_blank">@example</a></div>
        <div class="embed">
          <!-- X embed: replace the URL below with the tweet URL -->
          <iframe src="https://twitframe.com/show?url=https://x.com/Twitter/status/20"></iframe>
        </div>
      </article>

      <!-- CARD 2 -->
      <article class="card">
        <h3>Ling&Orm "ONLY YOU" Fan Meeting in Macao D2</h3>
        <div class="meta">November 23, 2025</div>
        <div class="source">Source: <a href="https://x.com/" target="_blank">@example</a></div>
        <div class="embed">
          <iframe src="https://twitframe.com/show?url=https://x.com/Twitter/status/1354143047324299264"></iframe>
        </div>
      </article>

      <!-- CARD 3 -->
      <article class="card">
        <h3>Ling&Orm "ONLY YOU" Fan Meeting in Macao D1</h3>
        <div class="meta">November 22, 2025</div>
        <div class="source">Source: <a href="https://x.com/" target="_blank">@example</a></div>
        <div class="embed">
          <iframe src="https://twitframe.com/show?url=https://x.com/Twitter/status/463440424141459456"></iframe>
        </div>
      </article>
    </section>

    <footer>© Fan Base · X Archive</footer>
  </div>
</body>
</html>
